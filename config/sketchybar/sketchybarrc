PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
sketchybar --bar position=top height=37 blur_radius=30 color=0x40000000 topmost=window sticky=on \
                 padding_left=10 padding_right=10 margin=10 corner_radius=10 y_offset=3

##### Changing Defaults #####
default=(
  padding_left=5
  padding_right=5
  icon.font="JetBrainsMono Nerd Font:Bold:16.0"
  label.font="JetBrainsMono Nerd Font:Regular:14.0"
  icon.color=0xffffffff
  label.color=0xffffffff
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

##### Aerospace Workspace Indicators #####
sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_mode_change
sketchybar --add event audio_output_change

for sid in $(aerospace list-workspaces --all); do
    sketchybar --add item space.$sid left \
        --subscribe space.$sid aerospace_workspace_change \
        --set space.$sid \
        background.color=0x44ffffff \
        background.corner_radius=5 \
        background.height=20 \
        background.drawing=off \
        icon.drawing=off \
        label="$sid" \
        label.font="JetBrainsMono Nerd Font:Bold:13.0" \
        click_script="aerospace workspace $sid" \
        script="$PLUGIN_DIR/aerospace.sh $sid"
done

##### Left Items #####
sketchybar --add item front_app left \
           --set front_app icon.drawing=off \
                           label.font="JetBrainsMono Nerd Font:Bold:13.0" \
                           script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched aerospace_workspace_change

##### Left - Mode Indicator #####
# Moved off-center so the notch-split clock stays symmetric around the notch.
sketchybar --add item mode left \
           --subscribe mode aerospace_mode_change \
           --set mode \
           label="" \
           label.font="JetBrainsMono Nerd Font:Bold:13.0" \
           label.color=0xffff6666 \
           script="$PLUGIN_DIR/mode.sh"

##### Center - Clock (split around the notch) #####
# date  ▐ notch ▌  time  — the transparent spacer reserves the notch width on
# the built-in display, and collapses to 0 on an external screen (clamshell) so
# the two halves sit together. See notch.sh.
sketchybar --add item cal center \
           --set cal update_freq=10 \
                     icon="" \
                     script="$PLUGIN_DIR/date.sh"

sketchybar --add item notch center \
           --set notch width=200 \
                       icon.drawing=off \
                       label.drawing=off \
                       background.drawing=off \
                       script="$PLUGIN_DIR/notch.sh" \
           --subscribe notch display_change space_change system_woke

sketchybar --add item time center \
           --set time update_freq=10 \
                      icon="" \
                      padding_right=15 \
                      script="$PLUGIN_DIR/time.sh"

##### Right Items #####
sketchybar --add item battery right \
           --set battery update_freq=120 \
                         script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change

sketchybar --add item volume right \
           --set volume script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change audio_output_change

sketchybar --add item ram right \
           --set ram update_freq=10 \
                     icon="󰘚" \
                     script="$PLUGIN_DIR/ram.sh"

sketchybar --add item cpu right \
           --set cpu update_freq=5 \
                     icon="󰍛" \
                     script="$PLUGIN_DIR/cpu.sh"

sketchybar --add item media right \
           --set media update_freq=1 \
                       icon="♫" \
                       label.max_chars=30 \
                       scroll_texts=on \
                       script="$PLUGIN_DIR/media.sh"

##### Force all scripts to run the first time #####
sketchybar --update
