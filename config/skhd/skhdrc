# ============================================
# skhd - Global Hotkeys
# ============================================
# These complement AeroSpace bindings.
# AeroSpace handles: window focus, move, resize, workspace switching
# skhd handles: app launching, system shortcuts, utilities

# ============================================
# App Launchers (hyper = cmd + alt + ctrl + shift)
# ============================================
cmd + alt - g : open -a "Ghostty"
cmd + alt - b : open -a "Arc"
cmd + alt - s : open -a "Slack"
cmd + alt - f : open -a "Finder"
cmd + alt - m : open -a "Spotify"
cmd + alt - z : open -a "Zed"

# ============================================
# Quick Utilities
# ============================================

# Toggle Do Not Disturb (Focus mode)
cmd + alt - d : shortcuts run "Toggle Focus"

# Lock screen
cmd + alt - l : pmset displaysleepnow

# ============================================
# SketchyBar Integration
# ============================================

# Refresh sketchybar
cmd + alt - r : sketchybar --update

# ============================================
# Media Controls (fn key alternatives)
# ============================================
cmd + alt - p : osascript -e 'tell application "Spotify" to playpause'
cmd + alt - 0x1E : osascript -e 'tell application "Spotify" to next track'
cmd + alt - 0x21 : osascript -e 'tell application "Spotify" to previous track'

# Volume controls
cmd + alt - 0x18 : osascript -e 'set volume output volume ((output volume of (get volume settings)) + 5)'
cmd + alt - 0x1B : osascript -e 'set volume output volume ((output volume of (get volume settings)) - 5)'

# Cycle audio output device
alt + shift - 0x1B : dev=$(SwitchAudioSource -t output -n) && sketchybar --trigger audio_output_change && osascript -e "display notification \"$dev\" with title \"Audio Output\""
